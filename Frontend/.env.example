# 복사해서 Frontend/.env.production 으로 저장 후 `npm run build` (.env* 는 커밋 금지)

# 백엔드 API 주소 (CloudFront 도메인 — /api/* 는 ALB로 라우팅)
VITE_API_URL=https://kkybot.net

# AWS WAF JavaScript SDK 주소 — Web ACL을 새로 만들면 주소가 바뀜
# CAPTCHA SDK:   aws wafv2 list-api-keys --scope CLOUDFRONT --region us-east-1 --query ApplicationIntegrationURL  + "jsapi.js"
# Challenge SDK: aws wafv2 get-web-acl --scope CLOUDFRONT --region us-east-1 --name <acl> --id <id> --query ApplicationIntegrationURL  + "challenge.js"
VITE_WAF_CAPTCHA_SDK_URL=https://<id>.edge.captcha-sdk.awswaf.com/<id>/jsapi.js
VITE_WAF_CHALLENGE_SDK_URL=https://<id>.edge.sdk.awswaf.com/<id>/<hash>/challenge.js

# CAPTCHA API 키 — 서비스 도메인용으로 발급
# aws wafv2 create-api-key --scope CLOUDFRONT --region us-east-1 --token-domains kkybot.net www.kkybot.net
VITE_WAF_CAPTCHA_API_KEY=
